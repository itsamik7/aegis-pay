# ==============================================================================
# PayU AEGIS-PAY - Production & Deployment Environment Configuration
# ==============================================================================

# Application Environment
APP_ENV=production
APP_PORT=8000
DEMO_MODE=true
ALLOW_SYNTHETIC_RESET=true

# Persistent Database (PostgreSQL / Supabase / Neon / AWS RDS)
# Local SQLite default: sqlite:///./aegis_pay.db
# Hosted PostgreSQL format:
# Supabase Pooler: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
# Neon Serverless:  postgresql://[user]:[password]@[endpoint].neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./aegis_pay.db

# Authentication & Session Security (Never commit production secret)
JWT_SECRET=demo-synthetic-secret-key-change-in-production-only-not-for-real-funds
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Bootstrap Initial Administrator Credentials (Used for first-time seed)
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=admin123

# Object Storage for CSV/XLSX Ingestion Uploads
# Options: local, vercel_blob, supabase_storage
STORAGE_PROVIDER=local
